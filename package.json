{
  "name": "face2face",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm dev:api",
    "dev:api": "pnpm --filter @face2face/api dev",
    "dev:web": "pnpm --filter @face2face/web dev",
    "ios": "bash scripts/ios.sh open",
    "ios:project": "bash scripts/ios.sh project",
    "ios:build": "bash scripts/ios.sh build",
    "dev:tailscale": "node scripts/dev-tailscale.mjs",
    "build": "pnpm --filter @face2face/api build && pnpm --filter @face2face/web build",
    "test:api": "node --test scripts/*.test.mjs && pnpm --filter @face2face/api test",
    "test:swift": "swift test --package-path apps/ios/Face2FaceCore",
    "test": "pnpm test:api && pnpm test:web && pnpm test:swift",
    "typecheck": "pnpm --filter @face2face/api typecheck && pnpm --filter @face2face/web typecheck",
    "lint": "biome lint .",
    "fmt": "biome check --write . && bash scripts/swift-format.sh format --in-place",
    "fmt:check": "biome check . && bash scripts/swift-format.sh lint --strict",
    "check:api": "biome check . && pnpm typecheck && pnpm test:api && pnpm test:web",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @face2face/api db:generate",
    "db:migrate": "pnpm --filter @face2face/api db:migrate",
    "types": "pnpm --filter @face2face/api types",
    "test:web": "pnpm --filter @face2face/web test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "6.0.3"
  }
}
