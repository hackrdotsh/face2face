{
  "name": "face2face",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @face2face/api dev",
    "dev:mobile": "pnpm --filter @face2face/mobile dev",
    "dev:tailscale": "node scripts/dev-tailscale.mjs",
    "build": "pnpm -r build",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @face2face/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @face2face/api db:generate",
    "db:migrate": "pnpm --filter @face2face/api db:migrate",
    "types": "pnpm --filter @face2face/api types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "6.0.3"
  }
}
