{
  "expo": {
    "name": "face2face",
    "slug": "face2face",
    "scheme": "face2face",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-secure-store", "expo-web-browser"]
  }
}
