{
  "name": "@face2face/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types --include-runtime false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.11",
    "vitest": "~4.1.0",
    "wrangler": "4.152.0"
  }
}
