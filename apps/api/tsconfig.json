{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": ["src", "test", "*.ts", "worker-configuration.d.ts"]
}
