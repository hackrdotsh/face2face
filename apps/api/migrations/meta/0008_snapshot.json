        "connection_blocked_by_matches_status": {
          "name": "connection_blocked_by_matches_status",
          "value": "(\"connection\".\"blocked_by\" IS NOT NULL) = (\"connection\".\"status\" = 'blocked')"
        },
        "connection_public_needs_both_consents": {
          "name": "connection_public_needs_both_consents",
          "value": "\"connection\".\"status\" <> 'public' OR (\"connection\".\"low_public_at\" IS NOT NULL AND \"connection\".\"high_public_at\" IS NOT NULL)"
        },
        "connection_open_needs_both_accepted": {
          "name": "connection_open_needs_both_accepted",
          "value": "\"connection\".\"status\" NOT IN ('private', 'public') OR (\"connection\".\"low_decision\" = 'accepted' AND \"connection\".\"high_decision\" = 'accepted')"
        }
