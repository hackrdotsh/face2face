{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "face2face-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "DEV_WEB_ORIGIN": "",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "WEB_ORIGINS": ["http://localhost:8081", "http://127.0.0.1:8081"],
    "EMAIL_TRANSPORT": "console",
    "EMAIL_FROM": "face2face <onboarding@resend.dev>",
    "PASSKEY_RP_ID": "localhost",
    "PASSKEY_ORIGINS": ["http://localhost:8787"]
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "face2face",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_COORDINATORS", "class_name": "UserCoordinator" }
    ]
  },
  "exports": {
    "UserCoordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "env": {
    "production": {
      "routes": [{ "pattern": "f2f.rocky.systems", "custom_domain": true }],
      "vars": {
        "DEV_WEB_ORIGIN": "",
        "BETTER_AUTH_URL": "https://f2f.rocky.systems",
        "WEB_ORIGINS": [],
        "EMAIL_TRANSPORT": "resend",
        "EMAIL_FROM": "face2face <no-reply@rocky.systems>",
        "PASSKEY_RP_ID": "f2f.rocky.systems",
        "PASSKEY_ORIGINS": ["https://f2f.rocky.systems"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "face2face",
          "database_id": "REPLACE_WITH_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "USER_COORDINATORS", "class_name": "UserCoordinator" }
        ]
      }
    }
  }
}
